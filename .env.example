# Port the app listens on (used by npm scripts and restart.sh)
PORT=3000

# Sub-path the app is served under, if behind a reverse proxy (e.g. /dewey).
# Leave blank to serve from the domain root. Must match the proxy prefix and
# the path in NEXTAUTH_URL. The proxy must forward the prefix unchanged
# (Caddy: `reverse_proxy /dewey* ...`, NOT `handle_path` which strips it).
NEXT_PUBLIC_BASE_PATH=

# Postgres connection string used by lib/pg.ts
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dewey2

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me
NEXTAUTH_URL=http://localhost:3000

# Optional: "Sign in with Google". When both are set, a Google button appears on
# the login screen. Google only proves identity — it signs in the existing Dewey
# account whose email matches the verified Google email (no auto-provisioning).
# Create an OAuth 2.0 Web client in Google Cloud and add this authorized redirect
# URI (include the base path if any): ${NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Anthropic key may live here instead of system_settings.
# When set, it takes precedence over the value stored in the database.
ANTHROPIC_API_KEY=

# Port the app listens on (used by npm scripts and restart.sh)
PORT=3000

# Postgres connection string used by lib/pg.ts
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dewey2

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me
NEXTAUTH_URL=http://localhost:3000

# Optional: Anthropic key may live here instead of system_settings.
# When set, it takes precedence over the value stored in the database.
ANTHROPIC_API_KEY=
